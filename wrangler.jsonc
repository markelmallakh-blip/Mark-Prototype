{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mark-prototype",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Lets previews fetch sites on this same Cloudflare account (e.g. *.workers.dev) like any public site.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  // Two hosts on the same registrable domain: the app, and a separate origin for masked previews.
  // Replace both with your real subdomains (and PREVIEW_ORIGIN below) before `npm run deploy`.
  "routes": [
    { "pattern": "prototype.example.com", "custom_domain": true },
    { "pattern": "preview.example.com", "custom_domain": true }
  ],
  "vars": { "PREVIEW_ORIGIN": "https://preview.example.com" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker routes everything (preview host, /api, app pages) and does the SPA fallback itself.
    "run_worker_first": true
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "rules": [{ "type": "Text", "globs": ["**/bridge.js"], "fallthrough": true }],
  "observability": { "enabled": true },
  // `npm run dev:worker`: no custom domains, so requests keep their real host
  // (localhost:8787 = app, 127.0.0.1:8787 = previews). Bindings don't inherit, so they're repeated.
  "env": {
    "dev": {
      "routes": [],
      "vars": { "PREVIEW_ORIGIN": "http://127.0.0.1:8787", "ALLOW_NO_PASSWORD": "1" },
      "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] }
    }
  }
}
